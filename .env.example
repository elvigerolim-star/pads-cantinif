# Navegador. Use a URL e a chave publicável do mesmo ambiente de teste.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=chave-publicavel-ficticia

# Servidor. Substitua localmente pelos valores do mesmo ambiente de teste.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=chave-publicavel-ficticia
SUPABASE_SERVICE_ROLE_KEY=chave-privilegiada-ficticia

# Conexão direta de migração. Preencha com a URL do PostgreSQL descartável.
LOVABLE_DB_MIGRATION_URL=

# Opcionais. Defina apenas quando o ambiente usar a autenticação de cron Lovable.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
